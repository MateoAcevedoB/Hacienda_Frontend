            "url": {
              "raw": "{{baseUrl}}/api/vacunacion/aplicar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vacunacion",
                "aplicar"
              ]
            },
            "description": "POST /api/vacunacion/aplicar. Requiere que potreroId/nombreRes/loteVacuna existan realmente (ejecutar antes 'Crear potrero', 'Agregar res' y 'Crear vacuna Bacteriana'). Responde 200 OK (no 201: no crea un recurso nuevo direccionable).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"potreroId\": \"{{potreroId}}\",\n  \"nombreRes\": \"{{nombreRes}}\",\n  \"loteVacuna\": \"{{loteVacuna}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 o 400', function () { pm.expect([200,400]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Aplicar vacuna - potrero inexistente (negativo)",
          "request": {
            "method": "POST",
