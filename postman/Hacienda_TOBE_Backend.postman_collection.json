      "name": "05 - Vacunación",
      "description": "VacunacionController: aplicar una vacuna del inventario disponible a una Res existente.",
      "item": [
        {
          "name": "Aplicar vacuna a una res",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
