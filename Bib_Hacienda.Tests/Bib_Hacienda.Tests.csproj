<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FASE 4A: proyecto de Unit Testing para la lógica de negocio de
    Bib_Hacienda, usando xUnit + Moq. Referencia ÚNICAMENTE a Bib_Hacienda
    (no a p_mvcHacienda ni a Api_Hacienda), para poder probar los servicios
    de aplicación mediante mocks de sus interfaces de repositorio, sin
    PostgreSQL/EF Core/archivos de texto.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- FASE 4C: única adición de esta fase. Habilita
         `dotnet test collect:"XPlat Code Coverage"` (data collector de
         VSTest) para medir line/branch coverage sin más configuración.
         No se agregó ReportGenerator como PackageReference porque es una
         herramienta de línea de comandos (dotnet tool), no una dependencia
         del proyecto de tests; se instalaría con
         `dotnet tool install -g dotnet-reportgenerator-globaltool` en un
         entorno con SDK .NET y acceso a NuGet, ninguno de los cuales está
         disponible en este entorno (ver reporte final). -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- FASE 4A: Bib_Hacienda.Tests -> Bib_Hacienda (única referencia).
         Sin referencia hacia p_mvcHacienda ni Api_Hacienda. -->
    <ProjectReference Include="..\Bib_Hacienda\Bib_Hacienda.csproj" />
  </ItemGroup>

</Project>
